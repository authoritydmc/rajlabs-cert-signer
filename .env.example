# Rajlabs Cert Signer — environment template (Coolify / Docker / local)
# Copy to .env and adjust. NEVER commit a real .env with secrets.

# --- Server ---
PORT=9000
# Public URL override (optional). When UNSET, the server auto-detects the
# public base per request from X-Forwarded-Proto/Host + BASE_PATH, so domain
# moves never need a redeploy for ACME/CRL/installer URLs.
# BASE_URL=https://certs.rajlabs.in
# Sub-path when behind a path-based proxy, e.g. UI at https://backend.rajlabs.in/cert-signer
# Use "auto" to learn it from the first request, or leave empty for root hosting.
BASE_PATH=
# BASE_PATH=/cert-signer
# BASE_PATH=auto

# --- Auth ---
ADMIN_USER=admin
# Set in Coolify env. Overrides stored hash on every boot (fixes "can't sign in after redeploy").
ADMIN_PASSWORD=change_me_in_coolify
# Legacy global API key fallback (prefer per-key tokens in UI → API Tokens):
# AUTH_TOKEN=rajlabs-secure-api-key-9988

# --- Encryption / DB ---
# Master key for AES-256-GCM intermediate keys at rest (set a long random value in prod):
# ENCRYPTION_KEY=change_me_to_32plus_random_chars
# Store is JSON at DATA_DIR/database.json (zero-config, same file as v1).
# Optional custom data dir: DATA_DIR=/app/data
# Relational store (Postgres) — recommended for production: concurrent-safe,
# transactional, with DB-backed sessions + audit table. Existing database.json
# (data + audit trail) migrates automatically on first Postgres boot.
# Unset/empty DATABASE_URL keeps the zero-config JSON file instead.
DATABASE_URL=postgres://pki:pki@postgres:5432/pki_signer
# Postgres container credentials (MUST match DATABASE_URL; override in prod!):
POSTGRES_USER=pki
POSTGRES_PASSWORD=change_this_postgres_password_in_production
POSTGRES_DB=pki_signer
# Any SQLAlchemy URL works: postgres://… (prod) or sqlite:////app/data/store.db (tests).
# If Postgres is unreachable at boot, the server logs loudly and sticks to JSON.

# --- Logging (enterprise structured JSONL to stdout; Coolify picks it up) ---
LOG_LEVEL=info
# LOG_LEVEL=debug
# Optional JSONL file append: LOG_FILE=/app/data/logs/app.log
# Audit trail (logins, issue, revoke, token/CA changes) always → DATA_DIR/logs/audit.log

# --- Integrations ---
# CORS for backend.rajlabs.in admin tab polling /api/v1/status (default *):
# CORS_ORIGIN=https://backend.rajlabs.in
